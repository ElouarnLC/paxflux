{
  "name": "paxflux",
  "version": "1.0.0",
  "description": "Self-hosted realtime crowd flow & occupancy management.",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build:shared": "npm run build -w @paxflux/shared",
    "build": "npm run build:shared && npm run build -w @paxflux/server && npm run build -w @paxflux/web",
    "pretypecheck": "npm run build:shared",
    "typecheck": "npm run typecheck -w @paxflux/shared && npm run typecheck -w @paxflux/server && npm run typecheck -w @paxflux/web",
    "pretest": "npm run build:shared",
    "test": "vitest run",
    "pretest:watch": "npm run build:shared",
    "test:watch": "vitest",
    "pretest:coverage": "npm run build:shared",
    "test:coverage": "vitest run --coverage",
    "pretest:e2e": "rimraf tests/e2e/.data tests/e2e/.backups && npm run build",
    "test:e2e": "playwright test",
    "predev:server": "npm run build:shared",
    "dev:server": "npm run dev -w @paxflux/server",
    "predev:web": "npm run build:shared",
    "dev:web": "npm run dev -w @paxflux/web",
    "predev": "npm run build:shared",
    "dev": "npm run dev -w @paxflux/server",
    "start": "node apps/server/dist/server.js",
    "predb:generate": "npm run build:shared",
    "db:generate": "npm run db:generate -w @paxflux/server",
    "predb:migrate": "npm run build:shared",
    "db:migrate": "npm run db:migrate -w @paxflux/server",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@playwright/test": "^1.62.1",
    "fake-indexeddb": "^6.2.5",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  },
  "license": "Apache-2.0"
}
