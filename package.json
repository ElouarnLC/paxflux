{
  "name": "paxflux",
  "version": "1.0.0",
  "description": "Self-hosted realtime crowd flow & occupancy management.",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dev:server": "npm run dev -w @paxflux/server",
    "dev:web": "npm run dev -w @paxflux/web",
    "dev": "npm run dev -w @paxflux/server",
    "start": "node apps/server/dist/server.js",
    "db:generate": "npm run db:generate -w @paxflux/server",
    "db:migrate": "npm run db:migrate -w @paxflux/server"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  },
  "license": "Apache-2.0"
}
